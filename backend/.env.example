# Mission Control backend — runtime config template.
#
# Read by: backend.config.BackendSettings (pydantic-settings) when
# `uvicorn backend.main:app` boots. Copy this file to `.env`, edit as
# needed, and the FastAPI bridge picks the values up on startup.
#
# No secrets live in this file. API keys, AdsPower tokens, and
# SadCaptcha credentials belong in the root adspower-mcp `.env`, not
# here. These values are non-sensitive runtime defaults.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# Comma-separated list of extra origins. The code always allows
# localhost:3000, *.vercel.app, and *.trycloudflare.com; entries here
# are additive for self-hosted frontends or custom tunnels.
BACKEND_ALLOWED_ORIGINS=http://localhost:3000

# Where the JSON proxy store and other runtime state are written.
DATA_DIR=./data

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
