# ─── AdsPower Local API ──────────────────────────────────────────────────────
ADSPOWER_BASE_URL=http://local.adspower.net:50325
ADSPOWER_API_KEY=
ADSPOWER_THROTTLE_SECONDS=1.1

# ─── Email signup (1secmail; domains rotate automatically on rejection) ─────
EMAIL_CODE_TIMEOUT_SECONDS=180

# ─── SadCaptcha (TikTok puzzle solver via tiktok-captcha-solver Python lib) ──
# Dashboard: https://sadcaptcha.com/dashboard  (25 free credits on signup)
# Pricing: $5 / 2500 solves on the starter tier; cheaper at volume
SADCAPTCHA_API_KEY=

# ─── TikTok signup defaults ──────────────────────────────────────────────────
TIKTOK_PROFILE_NAME_PREFIX=TikTok Acc
TIKTOK_DEFAULT_BIRTH_YEAR=1996

# ─── Warmup tuning ───────────────────────────────────────────────────────────
WARMUP_MIN_MINUTES=15
WARMUP_MAX_MINUTES=20
WARMUP_SCROLL_MIN_DELAY_SECONDS=5
WARMUP_SCROLL_MAX_DELAY_SECONDS=15

# Rotate the proxy's IP between every single account creation (true) or only
# between warmup cycles (false).
ROTATE_PROXY_BETWEEN_ACCOUNTS=true

# ─── Diagnostics ─────────────────────────────────────────────────────────────
SCREENSHOTS_DIR=./screenshots
RUN_STATE_DIR=./state
